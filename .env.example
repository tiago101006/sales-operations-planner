MYSQL_DATABASE=sop
MYSQL_USER=sop_dev
MYSQL_PASSWORD=substituir_por_password_local
MYSQL_ROOT_PASSWORD=substituir_por_outra_password_local
MYSQL_PORT=3307
BACKEND_PORT=8080
# false no ambiente HTTP local; true quando servido por HTTPS.
SESSION_COOKIE_SECURE=false
# IA local opcional. Executa ./nexoplan preparar-ia para descarregar o modelo.
SOP_AI_ENABLED=false
SOP_AI_MODEL=qwen3.5:4b-q4_K_M
